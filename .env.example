# Use these environment variables to set up the behaviour of conf.engine when built
VITE_FLAMAPY_CONF_MODE='full' # Either 'full' or 'embed'
#VITE_CANCEL_CONFIGURATION_URL='http://localhost:8000/configure'
#VITE_APPLY_CONFIGURATION_URL='http://localhost:8000/apply_configuration'
#VITE_FEATURE_MODEL_URL='http://localhost:8000/feature_model'
#VITE_FEATURE_MODEL_NAME=''
#VITE_BASENAME='' # Base path when serving the app under a sub-route
# M2T transformation template (Jinja). In 'embed' mode it is fetched from this URL;
# in 'full' mode the user may optionally upload one (this acts as fallback/default).
# If no template is available, the wizard shows the configuration for download instead.
#VITE_TEMPLATE_URL='/prompt_template.txt_es.jinja'

# Feature Toggles
VITE_USE_CONFIGURATOR='true' # If false, skips the wizard and goes straight to the result page for manual text input
